# Append/merge these RAG v5 values into your existing .env.
# Do NOT replace your current database, OpenAI, JWT or embedding secrets/settings.

# Stage 1 migration: keep query cutover OFF while v5 generations are built and audited.
RAG_V5_SCHEMA_ENABLED=1
RAG_V5_QUERY_ENABLED=0
RAG_V5_PROCESSING_VERSION=rag-v5.0.0

# Semantic evidence units: prose/list sections and one table row per child chunk.
RAG_V5_CHUNK_TARGET_CHARS=1000
RAG_V5_CHUNK_OVERLAP_CHARS=120

# Evidence-need hybrid retrieval / rank fusion.
RAG_V5_RETRIEVAL_PER_ARM=48
RAG_V5_FINAL_EVIDENCE=32
RAG_V5_PARENT_WINDOW=2

# Layout/table/OCR quality controls.
RAG_V5_MIN_TABLE_CONFIDENCE=0.62
RAG_V5_OCR_IMAGE_COVERAGE=0.45
OCR_LANGUAGES=eng+hin

# After cutover, mirror v5 semantic chunks into legacy document_chunks for rollback safety.
# The one-time migration does not touch v4 document_chunks because it runs with publish=false.
RAG_V5_LEGACY_CHUNK_MIRROR=1

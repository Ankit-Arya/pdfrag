# Smart RAG reliability overlay. Defaults are suitable for initial staging.
SMART_RAG_ENABLED=1
SMART_RAG_AUTO_SCHEMA=1
SMART_RAG_BUILD_INDEXES=1
SMART_RAG_QUERY_VARIANTS=4
SMART_RAG_VECTOR_K=90
SMART_RAG_FTS_K=90
SMART_RAG_SCOPED_K=70
SMART_RAG_PROCEDURE_CARD_K=12
SMART_RAG_ROUTED_DOCUMENTS=8
SMART_RAG_RULE_K=80
SMART_RAG_MAX_CANDIDATES=180
SMART_RAG_CORPUS_FALLBACK_K=160
SMART_RAG_FINAL_CONTEXT_CHUNKS=48
SMART_RAG_NEIGHBOR_SEEDS=60
SMART_RAG_NEIGHBOR_WINDOW=1
SMART_RAG_PRIMARY_CHUNKS_PER_DOCUMENT=64
SMART_RAG_REFERENCE_DOCUMENTS=4
SMART_RAG_REFERENCE_CHUNKS_PER_DOCUMENT=48
SMART_RAG_ALLOW_BROAD_FALLBACK=1
SMART_RAG_BROAD_FALLBACK_SCORE=0.12
SMART_RAG_LEGACY_FALLBACK_LIMIT=160
SMART_RAG_PRIORITY_FTS_K=80
SMART_RAG_AMOUNT_TABLE_K=80
SMART_RAG_STRUCTURED_VALUE_K=96
SMART_RAG_STRUCTURED_VALUE_CONTEXT_CHUNKS=12
SMART_RAG_CURRENT_AUTHORITY_CONTEXT_CHUNKS=16

# AI-first understanding/retrieval control. The query model may use general language
# knowledge to understand noisy wording, but final metro facts remain PDF-only.
SMART_RAG_AI_INTERPRETATION=1
SMART_RAG_AI_SEARCH_QUERIES=4
SMART_RAG_AI_INTERPRET_MAX_TOKENS=950
SMART_RAG_AI_EVIDENCE_REVIEW=1
SMART_RAG_AI_REVIEW_MAX_TOKENS=500
SMART_RAG_AI_RETRY_QUERIES=2
SMART_RAG_AI_RETRY_CANDIDATES=120
SMART_RAG_AI_ANSWER_VERIFY=1
SMART_RAG_AI_VERIFY_SOURCES=24
SMART_RAG_AI_VERIFY_MAX_TOKENS=1800

# Production embedding guidance: use a real transformer consistently. If you bake
# the model into the image, set these in the main .env and rebuild the backend:
# PRELOAD_EMBEDDING_MODEL=1
# REQUIRE_EMBEDDING_PRELOAD=1
# EMBEDDING_DOWNLOAD_ENABLED=0
# EMBEDDING_LOCAL_FILES_ONLY=1
# EMBEDDING_FALLBACK_MODE=disabled
# REQUIRE_EMBEDDING_AT_STARTUP=1

# The patch works with defaults; these values are exposed for tuning.
SMART_RAG_ENABLED=1
SMART_RAG_AUTO_SCHEMA=1
SMART_RAG_BUILD_INDEXES=1
SMART_RAG_QUERY_VARIANTS=3
SMART_RAG_VECTOR_K=90
SMART_RAG_FTS_K=90
SMART_RAG_SCOPED_K=70
SMART_RAG_PROCEDURE_CARD_K=12
SMART_RAG_ROUTED_DOCUMENTS=8
SMART_RAG_RULE_K=80
SMART_RAG_MAX_CANDIDATES=180
SMART_RAG_CORPUS_FALLBACK_K=160
SMART_RAG_FINAL_CONTEXT_CHUNKS=48
SMART_RAG_NEIGHBOR_SEEDS=60
SMART_RAG_NEIGHBOR_WINDOW=1
SMART_RAG_PRIMARY_CHUNKS_PER_DOCUMENT=64
SMART_RAG_REFERENCE_DOCUMENTS=4
SMART_RAG_REFERENCE_CHUNKS_PER_DOCUMENT=48
SMART_RAG_ALLOW_BROAD_FALLBACK=1
SMART_RAG_BROAD_FALLBACK_SCORE=0.12
SMART_RAG_LEGACY_FALLBACK_LIMIT=160

# Strongly recommended for production once your real transformer model is mounted/preloaded:
# EMBEDDING_FALLBACK_MODE=disabled
# REQUIRE_EMBEDDING_AT_STARTUP=true

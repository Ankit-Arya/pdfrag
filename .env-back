# Copy to .env and add your model credentials.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible endpoint. Leave blank for OpenAI.
LLM_BASE_URL=

# Retrieval and upload controls
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_FILE_SIZE_MB=200
MAX_FILES_PER_COLLECTION=20
MAX_TOTAL_PAGES=2000
COLLECTION_TTL_MINUTES=120
MAX_COLLECTIONS=100
TOP_K=12
MIN_SIMILARITY=0.05
MAX_CONTEXT_CHARS=30000

# Local development origins; production uses same-origin through nginx.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO


POSTGRES_DB=pdfrag
POSTGRES_USER=pdfrag
POSTGRES_PASSWORD=pdfrag
JWT_SECRET=dmrcjwtadminpassword
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin@123

# OPENAI_API_KEY=
# LLM_MODEL=gpt-4.1-mini
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
REQUIRE_EMBEDDING_PRELOAD=0
# REQUIRE_EMBEDDING_AT_STARTUP=0
# EMBEDDING_LOCAL_FILES_ONLY=0
# ALLOW_INSECURE_HF_DOWNLOAD=1
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

PRELOAD_EMBEDDING_MODEL=0
# EMBEDDING_DOWNLOAD_ENABLED=0
# EMBEDDING_FALLBACK_MODE=hashing
ALLOW_INSECURE_HF_DOWNLOAD=0

EMBEDDING_DOWNLOAD_ENABLED=1
EMBEDDING_LOCAL_FILES_ONLY=0
EMBEDDING_FALLBACK_MODE=disabled
REQUIRE_EMBEDDING_AT_STARTUP=1

OCR_MODE=auto
OCR_DPI=300
OCR_MIN_NATIVE_CHARS=80
OCR_MIN_TEXT_QUALITY=0.62
OCR_MIN_NATIVE_CONSENSUS=0.42
OCR_PRIMARY_PSM=3
OCR_FALLBACK_PSM=6
EXTRACT_TABLES=1